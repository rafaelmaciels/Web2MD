{
  "name": "web2md",
  "version": "1.0.0",
  "description": "Chrome & Microsoft Edge Extension to convert web pages into clean Markdown (.md) files",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:extension": "tsc && vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "mobile": "npm --prefix mobile start",
    "mobile:tunnel": "npm --prefix mobile run tunnel",
    "mobile:android": "npm --prefix mobile run android",
    "mobile:ios": "npm --prefix mobile run ios",
    "mobile:web": "npm --prefix mobile run web",
    "mobile:build:apk": "npm --prefix mobile run build:apk"
  },
  "dependencies": {
    "@mozilla/readability": "^0.5.0",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "turndown": "^7.2.0",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.280",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/turndown": "^5.0.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-static-copy": "^2.2.0"
  }
}
